<Window x:Class="AdaptiveMedia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adaptive Media" Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="32,24">
            <StackPanel>
                <TextBlock Text="Adaptive Media" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock Text="Choose media, review your playback plan, then press Play." Foreground="#D7DBE2" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Grid x:Name="MediaActions">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenFiles_Click">Choose _files</Button>
                    <Button Grid.Column="2" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenFolder_Click">Choose f_older</Button>
                    <Button Grid.Column="4" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenUrl_Click">Choose _URL</Button>
                </Grid>
                <TextBlock Text="Or drop files or a folder here to prepare a plan." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,12"/>
                <TextBlock x:Name="SelectedMediaText" Text="No media selected" TextWrapping="Wrap" Margin="2,0,0,18" FontWeight="SemiBold"/>

                <Border Background="{StaticResource CardBrush}" BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel x:Name="PlaybackChoices">
                        <TextBlock Text="Playback choices" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox AutomationProperties.Name="Playback preset" x:Name="ProfileBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Automatic" ToolTip="Sensible defaults for the current PC and source."/>
                                <ComboBoxItem Content="Reference" ToolTip="Preserve source cadence and colour intent; avoid optional processing."/>
                                <ComboBoxItem Content="Enhanced" ToolTip="Use the selected opt-in processing features for this launch."/>
                                <ComboBoxItem Content="Compatibility" ToolTip="Use the fallback playback path for troublesome files or drivers."/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Upscaling" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox AutomationProperties.Name="Upscaling" x:Name="UpscaleBox" Grid.Column="4" SelectedIndex="0">
                                <ComboBoxItem Content="Off" Tag="Off" ToolTip="No extra upscaling processing."/>
                                <ComboBoxItem Content="Automatic" Tag="Automatic" ToolTip="Dependable conventional scaling across GPUs."/>
                                <ComboBoxItem Content="High quality" Tag="HighQuality" ToolTip="EWA Lanczos Sharp scaling for lower-resolution video."/>
                                <ComboBoxItem Content="RTX Super Resolution" Tag="RtxVsr" ToolTip="Optional NVIDIA driver-assisted video upscaling."/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Automatic - sensible defaults | Reference - source-faithful | Enhanced - tuned processing | Compatibility - fallback path"
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="RTX Super Resolution needs compatible NVIDIA hardware. The plan explains any fallback."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Motion" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox AutomationProperties.Name="Motion" x:Name="MotionBox" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Top">
                                <ComboBoxItem Content="Native cadence" Tag="Off" ToolTip="Keep the source frame cadence. No interpolation."/>
                                <ComboBoxItem Content="Gentle smooth motion" Tag="Gentle" ToolTip="Light temporal interpolation to reduce judder. This is mpv cadence smoothing, not AI optical-flow frame generation."/>
                                <ComboBoxItem Content="Smooth motion" Tag="Smooth" ToolTip="Stronger temporal interpolation for smoother cadence; may create a soap-opera look. This is not AI optical-flow frame generation."/>
                            </ComboBox>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="Reduce colour banding" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CleanupBox" AutomationProperties.Name="Colour banding reduction" SelectedIndex="0" ToolTip="Reduce colour banding. Stronger settings may soften fine texture; this does not restore lost detail.">
                                    <ComboBoxItem Content="Off" Tag="Off"/>
                                    <ComboBoxItem Content="Gentle" Tag="Gentle"/>
                                    <ComboBoxItem Content="Normal" Tag="Normal"/>
                                    <ComboBoxItem Content="Strong" Tag="Strong"/>
                                    <ComboBoxItem Content="Automatic" Tag="Automatic"/>
                                </ComboBox>
                                <CheckBox x:Name="RtxHdrCheck" Content="RTX Video HDR" Margin="0,10,0,0" ToolTip="Experimental NVIDIA HDR enhancement. Never enabled automatically."/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Smoothing blends frames to reduce judder. It is not AI frame generation."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="Stronger banding reduction may soften texture. RTX HDR is experimental; support is checked in the plan."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <TextBlock Text="Reference preserves source cadence and colour. Your plan explains which selected enhancements can be used."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="RememberCheck" Content="Remember these playback choices as my defaults" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,18,0,0">
                    <StackPanel>
                        
                        
                        <TextBlock Text="Playback plan" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PlanText" Text="Choose media to see which playback choices can be used." TextWrapping="Wrap" Margin="0,10,0,14" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="SettingsWarningText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,14" Foreground="#984B00" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Playback activity" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RuntimeText" Text="Playback has not started. Driver activity is checked during playback where observable." TextWrapping="Wrap" Margin="0,6,0,16" AutomationProperties.LiveSetting="Polite"/>
                        <Expander Header="System details">
                        <TextBlock x:Name="SystemText" Text="Detecting hardware and display state…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#D7DCE3" BorderThickness="0,1,0,0" Padding="26,14" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="v0.4.0-rc1" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,4,14,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="_Settings" Click="Settings_Click" Margin="0,0,10,0"/>
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,10,0"/><Button Content="Diagnostics folder" Click="Diagnostics_Click" Margin="0,0,10,0"/>
                    <Button x:Name="PlayButton" Content="_Play" Click="Play_Click" IsEnabled="False" MinWidth="94" FontWeight="SemiBold" Background="{StaticResource AccentBrush}" Foreground="White" AutomationProperties.HelpText="Start the playback plan shown above"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>





<Window x:Class="AdaptiveMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adaptive Media Settings" Width="660" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="System-wide playback behaviours. Per-video enhancement choices stay on the main launcher." Foreground="#667085" Margin="0,4,0,18"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <CheckBox x:Name="HdrCheck" Content="Automatically switch HDR on an unambiguous active HDMI display and restore it after playback" Margin="0,10"/>
            <CheckBox x:Name="ExternalCheck" Content="Prefer an external display when connected" Margin="0,10"/>
            <CheckBox x:Name="FullscreenCheck" Content="Start fullscreen on the preferred external display" Margin="0,10"/>
            <CheckBox x:Name="BitstreamCheck" Content="Enable HDMI bitstream for AC-3 / E-AC-3 / TrueHD / DTS-HD when HDMI is active" Margin="0,10"/>
            <TextBlock Text="Leave bitstream off for laptop speakers, ordinary TV speakers, Bluetooth, USB audio, or Dolby Atmos for Headphones." TextWrapping="Wrap" Foreground="#667085" Margin="24,0,0,10"/>
            <CheckBox x:Name="MpcCheck" Content="Offer MPC-BE if MPV reports a playback failure" Margin="0,10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

est-Path $script:SettingsPath)) { return $d }
    try {
        $u = Get-Content -LiteralPath $script:SettingsPath -Raw | ConvertFrom-Json
        foreach ($p in $d.PSObject.Properties.Name) {
            if ($null -ne $u.PSObject.Properties[$p]) { $d.$p = $u.$p }
        }
    } catch {}
    return $d
}

function Save-Settings {
    param($Settings)
    $Settings | ConvertTo-Json | Set-Content -LiteralPath $script:SettingsPath -Encoding UTF8
}

$script:Settings = Load-Settings

function Load-State {
    if (Test-Path $script:StatePath) {
        try { return Get-Content -LiteralPath $script:StatePath -Raw | ConvertFrom-Json } catch {}
    }
    return [pscustomobject]@{}
}
$script:State = Load-State

function Resolve-Mpv {
    $paths = @()
    if ($script:State.PSObject.Properties['mpvPath']) { $paths += [string]$script:State.mpvPath }
    $cmd = Get-Command mpv.exe -ErrorAction SilentlyContinue
    if ($cmd) { $paths += $cmd.Source }
    $paths += @(
        (Join-Path $env:LOCALAPPDATA 'Programs\mpv\mpv.exe'),
        (Join-Path $env:LOCALAPPDATA 'mpv\mpv.exe'),
        (Join-Path $env:ProgramFiles 'mpv\mpv.exe')
    )
    foreach ($p in $paths | Select-Object -Unique) { if ($p -and (Test-Path $p)) { return $p } }
    return $null
}

function Resolve-MpcBe {
    $cmd = Get-Command mpc-be64.exe -ErrorAction SilentlyContinue
    if ($cmd) { return $cmd.Source }
    foreach ($p in @(
        (Join-Path $env:ProgramFiles 'MPC-BE x64\mpc-be64.exe'),
        (Join-Path $env:ProgramFiles 'MPC-BE\mpc-be64.exe'),
        (Join-Path $env:LOCALAPPDATA 'Programs\MPC-BE x64\mpc-be64.exe')
    )) { if (Test-Path $p) { return $p } }
    return $null
}

function Get-HdrDisplays {
    if (-not $script:HdrInteropAvailable) { return @() }
    try { return @([AdaptiveMedia.Native.HdrController]::GetDisplays()) } catch { return @() }
}

function Restore-RecoveryState {
    if (-not (Test-Path $script:RecoveryPath) -or -not $script:HdrInteropAvailable) { return }
    try {
        $saved = Get-Content -LiteralPath $script:RecoveryPath -Raw | ConvertFrom-Json
        foreach ($d in @($saved.displays)) {
            [void][AdaptiveMedia.Native.HdrController]::SetState([uint32]$d.AdapterLow, [int]$d.AdapterHigh, [uint32]$d.TargetId, [bool]$d.Enabled)
        }
        Remove-Item -LiteralPath $script:RecoveryPath -Force -ErrorAction SilentlyContinue
    } catch {}
}
Restore-RecoveryState

function Test-IsUrl([string]$Text) {
    if ([string]::IsNullOrWhiteSpace($Text)) { return $false }
    $uri = $null
    if ([uri]::TryCreate($Text, [UriKind]::Absolute, [ref]$uri)) {
        return $uri.Scheme -in @('http','https','rtsp','rtmp','ftp')
    }
    return $false
}

function Get-NaturalKey([string]$Text) {
    $eval = [System.Text.RegularExpressions.MatchEvaluator]{ param($m) $m.Value.PadLeft(12, '0') }
    return [regex]::Replace($Text, '\d+', $eval)
}

function Get-MediaFromFolder([string]$Folder) {
    $exts = @('.mkv','.mp4','.m4v','.avi','.mov','.webm','.ts','.m2ts','.flv','.wmv','.mp3','.flac','.m4a','.aac','.opus','.wav','.ogg')
    @(Get-ChildItem -LiteralPath $Folder -File -ErrorAction SilentlyContinue |
        Where-Object { $exts -contains $_.Extension.ToLowerInvariant() } |
        Sort-Object @{Expression={ Get-NaturalKey $_.Name }} |
        ForEach-Object { $_.FullName })
}

function New-PlaylistFile([string[]]$Items) {
    $path = Join-Path $env:TEMP ('adaptive-media-' + [guid]::NewGuid().ToString('N') + '.m3u8')
    $lines = @('#EXTM3U') + $Items
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllLines($path, $lines, $utf8)
    return $path
}

function Probe-Media([string]$Mpv, [string]$Item) {
    if (-not (Test-Path -LiteralPath $Item -PathType Leaf)) { return $null }
    try {
        $marker = 'AMPROBE|${width}|${height}|${container-fps}|${video-codec}|${video-params/gamma}|${video-params/primaries}|${audio-codec-name}'
        $out = & $Mpv --no-config --frames=1 --vo=null --ao=null --really-quiet "--term-playing-msg=$marker" -- "$Item" 2>&1 | Out-String
        $line = ($out -split "`r?`n" | Where-Object { $_ -like 'AMPROBE|*' } | Select-Object -Last 1)
        if (-not $line) { return $null }
        $p = $line -split '\|', 8
        if ($p.Count -lt 8) { return $null }
        return [pscustomobject]@{
            Width = $p[1]; Height = $p[2]; Fps = $p[3]; VideoCodec = $p[4]
            Gamma = $p[5]; Primaries = $p[6]; AudioCodec = $p[7]
            HdrFamily = ($p[5] -eq 'pq' -or $p[5] -eq 'hlg')
        }
    } catch { return $null }
}

function Get-TargetScreen {
    $screens = @([System.Windows.Forms.Screen]::AllScreens)
    if ($screens.Count -eq 0) { return $null }
    if (-not $script:Settings.PreferExternalDisplay -or $screens.Count -eq 1) {
        return [pscustomobject]@{ Screen = $screens[0]; Index = 0; External = $false }
    }
    $choices = for ($i=0; $i -lt $screens.Count; $i++) {
        if (-not $screens[$i].Primary) {
            [pscustomobject]@{ Screen=$screens[$i]; Index=$i; Area=($screens[$i].Bounds.Width * $screens[$i].Bounds.Height); External=$true }
        }
    }
    $picked = $choices | Sort-Object Area -Descending | Select-Object -First 1
    if ($picked) { return $picked }
    return [pscustomobject]@{ Screen = $screens[0]; Index = 0; External = $false }
}

function Capture-HdrState {
    $displays = Get-HdrDisplays
    if ($displays.Count -eq 0) { return @() }
    return @($displays | Select-Object AdapterLow,AdapterHigh,TargetId,Name,OutputTechnology,Supported,Enabled,ForceDisabled)
}

function Apply-HdrPolicy($Probe) {
    if (-not $script:Settings.AutoHdrSwitch -or -not $script:HdrInteropAvailable -or $null -eq $Probe) { return $null }
    if ([string]::IsNullOrWhiteSpace([string]$Probe.VideoCodec)) { return $null }
    $before = Capture-HdrState
    # The Windows 10 compatibility API represents HDR/WCG together. To avoid
    # touching an internal WCG/ACM panel, v0.1 only auto-switches active HDMI paths.
    # If 
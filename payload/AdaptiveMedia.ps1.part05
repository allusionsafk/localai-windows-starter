function New-BigButton([string]$Text,[int]$X) {
    $b = New-Object System.Windows.Forms.Button
    $b.Text = $Text; $b.Location = New-Object System.Drawing.Point($X,155); $b.Size = New-Object System.Drawing.Size(245,86)
    $b.FlatStyle = 'Flat'; $b.FlatAppearance.BorderColor = [System.Drawing.Color]::FromArgb(210,214,220); $b.BackColor = [System.Drawing.Color]::White
    $b.Font = New-Object System.Drawing.Font('Segoe UI Semibold',13); $b.Cursor = [System.Windows.Forms.Cursors]::Hand
    $form.Controls.Add($b); return $b
}

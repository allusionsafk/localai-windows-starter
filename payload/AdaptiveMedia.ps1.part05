ck.Checked
        Save-Settings $script:Settings
    }
}

function Write-Diagnostics {
    $path = Join-Path ([Environment]::GetFolderPath('Desktop')) ('Adaptive Media Diagnostics ' + (Get-Date -Format 'yyyy-MM-dd HHmmss') + '.txt')
    $lines = New-Object System.Collections.Generic.List[string]
    $lines.Add('ADAPTIVE MEDIA DIAGNOSTICS')
    $lines.Add('Generated: ' + (Get-Date).ToString('yyyy-MM-dd HH:mm:ss K'))
    $lines.Add('')
    try {
        $os = Get-CimInstance Win32_OperatingSystem; $cs = Get-CimInstance Win32_ComputerSystem; $cpu = Get-CimInstance Win32_Processor
        $lines.Add('Computer: ' + $env:COMPUTERNAME)
        $lines.Add('Manufacturer / Model: ' + $cs.Manufacturer + ' / ' + $cs.Model)
        $lines.Add('OS: ' + $os.Caption + ' ' + $os.Version + ' build ' + $os.BuildNumber)
        $lines.Add('CPU: ' + (($cpu | ForEach-Object Name) -join '; '))
        $lines.Add('RAM: ' + [math]::Round($cs.TotalPhysicalMemory / 1GB, 1) + ' GB')
    } catch {}
    try { $lines.Add('GPU(s): ' + ((Get-CimInstance Win32_VideoController | ForEach-Object { $_.Name + ' driver ' + $_.DriverVersion }) -join '; ')) } catch {}
    $lines.Add('')
    $lines.Add('Windows screens:')
    $idx = 0
    foreach ($s in @([System.Windows.Forms.Screen]::AllScreens)) {
        $lines.Add(('  [{0}] {1} {2}x{3} primary={4}' -f $idx,$s.DeviceName,$s.Bounds.Width,$s.Bounds.Height,$s.Primary)); $idx++
    }
    $lines.Add('')
    $lines.Add('DisplayConfig / HDR:')
    if ($script:HdrInteropAvailable) {
        foreach ($d in (Get-HdrDisplays)) {
            $tech = if ($d.OutputTechnology -eq 5) { 'HDMI' } elseif ($d.OutputTechnology -eq 10) { 'DisplayPort' } elseif ($d.OutputTechnology -eq 11) { 'Embedded DisplayPort' } else { 'technology ' + $d.OutputTechnology }
            $lines.Add(('  [{0}] {1} | {2} | HDR/WCG supported={3} enabled={4} force-disabled={5}' -f $d.Index,$d.Name,$tech,$d.Supported,$d.Enabled,$d.ForceDisabled))
        }
    } else { $lines.Add('  Native HDR helper unavailable; Adaptive Media will rely on mpv/libplacebo without switching Windows HDR.') }
    $lines.Add('')
    try { $lines.Add('Audio devices: ' + ((Get-CimInstance Win32_SoundDevice | ForEach-Object Name) -join '; ')) } catch {}
    $lines.Add('Power: ' + [System.Windows.Forms.SystemInformation]::PowerStatus.PowerLineStatus)
    $lines.Add('')
    $mpv = Resolve-Mpv
    $lines.Add('MPV: ' + $(if ($mpv) { $mpv } else { '(not found)' }))
    if ($mpv) { try { $lines.Add('MPV version: ' + ((& $mpv --no-config --version | Select-Object -First 1) -join '')) } catch {} }
    $ytdlp = Get-Command yt-dlp.exe -ErrorAction SilentlyContinue
    if (-not $ytdlp) { $yp = Join-Path $script:ToolsDir 'yt-dlp.exe'; if (Test-Path $yp) { $ytdlp = [pscustomobject]@{Source=$yp} } }
    $lines.Add('yt-dlp: ' + $(if ($ytdlp) { $ytdlp.Source } else { '(not found)' }))
    $lines.Add('MPC-BE: ' + $(if (Resolve-MpcBe) { Resolve-MpcBe } else { '(not found)' }))
    $lines.Add('')
    $lines.Add('Settings: ' + ($script:Settings | ConvertTo-Json -Compress))
    $lines.Add('')
    $lines.Add('Dolby Vision note: DV source processing is not the same as native Dolby Vision HDMI metadata output. Adaptive Media does not claim native DV passthrough.')
    $lines | Set-Content -LiteralPath $path -Encoding UTF8
    Start-Process notepad.exe -ArgumentList ('"' + $path + '"') | Out-Null
}


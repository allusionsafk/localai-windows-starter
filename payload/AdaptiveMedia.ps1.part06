ws.Forms.ComboBox
$profile.DropDownStyle = 'DropDownList'; $profile.Location = New-Object System.Drawing.Point(165,305); $profile.Size = New-Object System.Drawing.Size(220,30)
[void]$profile.Items.AddRange(@('Automatic','Reference','Enhanced','Compatibility')); $profile.SelectedItem = [string]$script:Settings.Profile
if ($profile.SelectedIndex -lt 0) { $profile.SelectedIndex = 0 }
$form.Controls.Add($profile)
$profile.Add_SelectedIndexChanged({ $script:Settings.Profile = [string]$profile.SelectedItem; Save-Settings $script:Settings })

$modeHelp = New-Object System.Windows.Forms.Label
$modeHelp.Text = 'Automatic uses Reference on AC power and a lighter profile on battery. Enhancement is never forced on pristine material.'
$modeHelp.Location = New-Object System.Drawing.Point(32,345); $modeHelp.Size = New-Object System.Drawing.Size(790,42); $modeHelp.ForeColor = [System.Drawing.Color]::DimGray; $form.Controls.Add($modeHelp)

$statusPanel = New-Object System.Windows.Forms.Panel
$statusPanel.Location = New-Object System.Drawing.Point(32,405); $statusPanel.Size = New-Object System.Drawing.Size(796,115); $statusPanel.Anchor = 'Left,Right,Bottom'; $statusPanel.BackColor = [System.Drawing.Color]::White; $statusPanel.BorderStyle = 'FixedSingle'; $form.Controls.Add($statusPanel)
$statusTitle = New-Object System.Windows.Forms.Label
$statusTitle.Text = 'Current system'; $statusTitle.Font = New-Object System.Drawing.Font('Segoe UI Semibold',11); $statusTitle.Location = New-Object System.Drawing.Point(16,12); $statusTitle.AutoSize = $true; $statusPanel.Controls.Add($statusTitle)
$status = New-Object System.Windows.Forms.Label
$status.Location = New-Object System.Drawing.Point(16,42); $status.Size = New-Object System.Drawing.Size(755,62); $status.ForeColor = [System.Drawing.Color]::FromArgb(55,60,68); $statusPanel.Controls.Add($status)

try {
    $gpus = (Get-CimInstance Win32_VideoController -ErrorAction SilentlyContinue | ForEach-Object Name) -join ' + '
    $screens = @([System.Windows.Forms.Screen]::AllScreens)
    $hd = Get-HdrDisplays
    $hdrText = if ($hd.Count -gt 0) { (($hd | Where-Object Supported | ForEach-Object { $_.Name + ': HDR ' + $(if ($_.Enabled) {'ON'} else {'available'}) }) -join '; ') } else { 'HDR API: no supported active target reported' }
    $status.Text = "GPU: $gpus`r`nDisplays: $($screens.Count) active | $hdrText`r`nAudio: " + $(if ($script:Settings.HdmiBitstream) {'HDMI bitstream enabled when HDMI is present'} else {'PCM / Windows audio (safe default)'})
} catch { $status.Text = 'Hardware status could not be fully queried. Playback will use conservative defaults.' }

$settingsBtn = New-Object System.Windows.Forms.Button
$settingsBtn.Text = 'Settings'; $settingsBtn.Location = New-Object System.Drawing.Point(620,545); $settingsBtn.Size = New-Object System.Drawing.Size(98,32); $settingsBtn.Anchor = 'Right,Bottom'; $form.Controls.Add($settingsBtn)
$diagBtn = New-Object System.Windows.Forms.Button
$diagBtn.Text = 'Diagnostics'; $diagBtn.Location = New-Object System.Drawing.Point(730,545); $diagBtn.Size = New-Object System.Drawing.Size(98,32); $diagBtn.Anchor = 'Right,Bottom'; $form.Controls.Add($diagBtn)
$version = New-Object System.Windows.Forms.Label
$version.Text = 'v0.1.0'; $version.Location = New-Object System.Drawing.Point(32,553); $version.AutoSize = $true; $version.ForeColor = [System.Drawing.Color]::Gray; $version.Anchor='Left,Bottom'; $form.Controls.Add($version)

$fileBtn.Add_Click({
    $dlg = New-Object System.Windows.Forms.OpenFileDialog
    $dlg.Title = 'Open media in Adaptive Media'; $dlg.Multiselect = $true
    $dlg.Filter = 'Media files|*.mkv;*.mp4;*.m4v;*.avi;*.mov;*.webm;*.ts;*.m2ts;*.flv;*.wmv;*.mp3;*.flac;*.m4a;*.aac;*.opus;*.wav;*.ogg|All files|*.*'
    if ($dlg.ShowDialog($form) -eq [System.Windows.Forms.DialogResult]::OK) { Play-Media $dlg.FileNames }
})
$folderBtn.Add_Click({
    $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
    $dlg.Description = 'Choose a folder. Playable files in the folder will be naturally sorted into a playlist.'
    $dlg.ShowNewFolderButton = $false
    if ($dlg.ShowDialog($form) -eq [System.Windows.Forms.DialogResult]::OK) { Play-Media @($dlg.SelectedPath) }
})
$urlBtn.Add_Click({ Show-UrlDialog })
$settingsBtn.Add_Click({ Show-SettingsDialog })
$diagBtn.Add_Click({ Write-Diagnostics })

$form.Add_DragEnter({
    param($sender,$e)
    if ($e.Data.GetDataPresent([System.Windows.Forms.DataFormats]::FileDrop) -or $e.Data.GetDataPresent([System.Windows.Forms.DataFormats]::Text)) {
        $e.Effect = [System.Windows.Forms.DragDropEffects]::Copy
    }
})
$form.Add_DragDrop({
    param($sender,$e)
    if ($e.Data.GetDataPresent([System.Windows.Forms.DataFormats]::FileDrop)) {
        Play-Media @($e.Data.GetData([System.Windows.Forms.DataFormats]::FileDrop))
    } elseif ($e.Data.GetDataPresent([System.Windows.Forms.DataFormats]::Text)) {
        $text = [string]$e.Data.GetData([System.Windows.Forms.DataFormats]::Text)
        if (Test-IsUrl $text) { Play-Media @($text) 'bestvideo+bestaudio/best' }
    }
})

if ($LaunchItems -and $LaunchItems.Count -gt 0) {
    $form.Add_Shown({ Play-Media @($LaunchItems) })
}

[void][System.Windows.Forms.Application]::Run($form)
